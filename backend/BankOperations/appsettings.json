{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:bank-operations-server.database.windows.net,1433;Initial Catalog=bank-operations-db;Persist Security Info=False;User ID=sqladmin;Password={DB_PASSWORD};MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "Jwt": {
    "Secret": "{JWT_SECRET}",
    "Issuer": "bank-operations-api",
    "Audience": "bank-operations-client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": "587",
    "FromEmail": "{EMAIL_ADDRESS}",
    "FromName": "Bank Operations",
    "Password": "{EMAIL_PASSWORD}"
  }
}
